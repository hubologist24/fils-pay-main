FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY db/ ./db/
COPY scripts/ ./scripts/
RUN npm install --no-audit --no-fund
WORKDIR /app
